{
    "name": "mcp-gateway",
    "version": "0.6.1",
    "type": "module",
    "description": "A macOS menu-bar app for independently exposing local stdio MCP servers and existing Streamable HTTP servers on a trusted LAN.",
    "repository": {
        "url": "https://github.com/zaherg/mcp-gateway"
    },
    "license": "MIT",
    "scripts": {
        "prepare:sdk": "bun scripts/toolchain.ts prepare",
        "dev": "bun scripts/build.ts dev",
        "build": "bun scripts/build.ts dev-build",
        "release": "bun scripts/build.ts stable",
        "release:test": "bun scripts/build.ts stable-test",
        "typecheck": "tsc --noEmit",
        "lint": "biome check src tests scripts *.ts",
        "format": "biome check --write --linter-enabled=false src tests scripts *.ts *.json",
        "ui:build": "vite build"
    },
    "dependencies": {
        "jsonc-parser": "^3.3.1",
        "supergateway": "4.2.1"
    },
    "devDependencies": {
        "@base-ui/react": "^1.9.0",
        "@biomejs/biome": "^2.6.6",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/language": "^6.13.1",
        "@codemirror/legacy-modes": "^6.5.5",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@lezer/highlight": "^1.2.5",
        "@modelcontextprotocol/sdk": "1.30.0",
        "@tailwindcss/vite": "^4.3.5",
        "@types/bun": "^1.4.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cors": "^2.8.6",
        "electrobun": "^2.0.6",
        "eventsource-parser": "4.1.3",
        "express": "^4.22.3",
        "lucide-react": "^1.72.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "zod": "4.6.7"
    }
}
