{
    "name": "mcp-gateway",
    "version": "0.3.1",
    "type": "module",
    "description": "A macOS menu-bar app for independently exposing local stdio MCP servers and existing Streamable HTTP servers on a trusted LAN.",
    "repository": {
        "url": "https://github.com/zaherg/mcp-gateway"
    },
    "license": "MIT",
    "scripts": {
        "prepare:sdk": "bun scripts/toolchain.ts prepare",
        "dev": "bun scripts/build.ts dev",
        "build": "bun scripts/build.ts dev-build",
        "build:linux": "bun scripts/build.ts linux",
        "build:windows": "bun scripts/build.ts windows",
        "release": "bun scripts/build.ts stable",
        "test": "bun run test:unit",
        "test:unit": "bun test tests/core tests/main tests/regressions tests/native/update-acceptance",
        "test:components": "node node_modules/vitest/vitest.mjs run",
        "test:e2e": "bun scripts/test-e2e.ts",
        "typecheck": "tsc --noEmit",
        "lint": "biome check src tests scripts *.ts",
        "fix" : "biome format src tests scripts *.ts package.json",
        "ui:build": "vite build"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "effect": "^4.1.2",
        "express": "^4.22.3",
        "jsonc-parser": "^3.3.1",
        "lucide-react": "^1.70.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "supergateway": "^4.2.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.6",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/bun": "^1.4.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "electrobun": "^2.0.6",
        "jsdom": "^30.1.3",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}
