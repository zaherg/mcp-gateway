# Copy to .env and fill in the values.
# It configures notarization for bun run release, the private update-test feed
# for bun run release:test, and the publisher scripts/publish-test-feed.ts.
# Bun loads .env automatically; exported environment variables take precedence.
# Never put real credentials in this example or commit .env.

# --- Release signing (bun run release) ---

# The Developer ID Application certificate and private key must be in Keychain.
# The build script discovers the signing identity automatically.

# Apple Account email used for notarization.
APPLE_ID=

# Your 10-character Apple Developer Team ID.
APPLE_TEAM_ID=

# App-specific password for that Apple Account, not the account password.
APPLE_APP_PASSWORD=

# --- Optional output folders ---

# Optional project-relative build folder. Uncomment to keep releases separate.
# MCP_GATEWAY_BUILD_ROOT=build/release-final

# Optional artifact folder. Choose a fresh path for each release.
# MCP_GATEWAY_ARTIFACTS_DIR=.cache/release-candidate/assets

# --- Private update testing (bun run release:test, scripts/publish-test-feed.ts) ---

# release:test signs without notarization, so Apple account credentials are not needed.
# bun run release ignores everything in this section.

# Base URL baked into release:test builds: HTTPS (or loopback HTTP), with no
# trailing slash, query or credentials.
# MCP_GATEWAY_TEST_FEED=https://s3.mac.srvr.dev/mcp-gateway/test/stable

# Existing rclone S3 remote name, without a colon; credentials stay in rclone.
# MCP_GATEWAY_TEST_FEED_REMOTE=rustfs

# <bucket>/<prefix> where the publisher uploads the three updater files.
# The bucket policy must allow anonymous s3:GetObject there, and when the feed
# URL has the same host as the remote, its path must match this value.
# MCP_GATEWAY_TEST_FEED_S3_PATH=mcp-gateway/test/stable
