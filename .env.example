# Copy to .env and fill in the values before running bun run release.
# Bun loads .env automatically; exported environment variables take precedence.
# Never put real credentials in this example or commit .env.

# Apple Account email used for notarization.
APPLE_ID=

# Your 10-character Apple Developer Team ID.
APPLE_TEAM_ID=

# App-specific password for that Apple Account, not the account password.
APPLE_APP_PASSWORD=

# Optional project-relative build folder. Uncomment to keep releases separate.
# MCP_GATEWAY_BUILD_ROOT=build/release-final

# Optional artifact folder. Choose a fresh path for each release.
# MCP_GATEWAY_ARTIFACTS_DIR=.cache/release-candidate/assets

# The Developer ID Application certificate and private key must be in Keychain.
# The build script discovers the signing identity automatically.
